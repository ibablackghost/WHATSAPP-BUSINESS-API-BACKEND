# Django
DEBUG=True
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=whatbot_pro.settings.dev

# Database
DATABASE_URL=postgres://whatbot:whatbot@localhost:5432/whatbot_pro

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Encryption Fernet (laisser vide en dev = clé dérivée de SECRET_KEY)
# Générer en prod: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=whatbot-pro-media
AWS_S3_REGION_NAME=eu-west-1
USE_S3=False

# Payments
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
FREE_MONEY_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
