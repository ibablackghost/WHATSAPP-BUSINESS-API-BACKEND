# Copier vers .env.docker pour docker compose -f docker-compose.prod.yml
# Ne pas committer .env.docker (secrets)

POSTGRES_DB=whatbot_pro
POSTGRES_USER=whatbot
POSTGRES_PASSWORD=change-me-strong-password

WEB_PORT=8000
WEB_CONCURRENCY=2

SECRET_KEY=change-me-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Derrière un reverse proxy HTTPS (nginx, traefik)
SECURE_SSL_REDIRECT=false

FIELD_ENCRYPTION_KEY=

WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_SKIP_SIGNATURE=false

OPENAI_API_KEY=

WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
