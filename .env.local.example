# Copier vers .env :  copy .env.local.example .env

DJANGO_SETTINGS_MODULE=whatbot_pro.settings.local

DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Pas de PostgreSQL / Redis en local — SQLite + mémoire (voir settings/local.py)

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

FIELD_ENCRYPTION_KEY=

WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=whatbot-verify-token
WHATSAPP_APP_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

USE_S3=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
FREE_MONEY_API_KEY=
